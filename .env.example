# ---- Docker Compose (copy to .env in the repository root) ----
POSTGRES_PASSWORD=change-me-long-random
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# First administrator, created on startup when the users table is empty.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=Change-Me-To-A-Strong-Passphrase-1
# Optional: enables the LLM explanation layer (falls back to the deterministic narrative when empty).
ANTHROPIC_API_KEY=
BACKEND_PORT=8000
FRONTEND_PORT=3000
PUBLIC_API_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# ---- Local development without Docker (backend/.env and frontend/.env.local) ----
# backend/.env
#   DATABASE_URL=postgresql+psycopg://ipsec:ipsec@localhost:5432/ipsec_analyzer
#   TSHARK_PATH=C:\Program Files\Wireshark\tshark.exe
#   JWT_SECRET=...
